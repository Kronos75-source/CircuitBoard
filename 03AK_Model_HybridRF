# =============================================================================
# 7. HYBRID MODEL CLASS
# =============================================================================

class HybridTTOPRandomForest:
    """
    Production hybrid model.
    Prediction = TTOP + RF_residual
    """
    
    def __init__(self, rf_model, feature_names):
        self.rf_model = rf_model
        self.feature_names = feature_names
    
    def calculate_ttop_from_features(self, X):
        """Extract TTOP from feature matrix (assumes TTOP is a feature)."""
        ttop_idx = self.feature_names.index('TTOP')
        return X[:, ttop_idx]
    
    def predict_residual(self, X):
        """Predict residual (MAGT - TTOP)."""
        if isinstance(X, pd.DataFrame):
            X = X[self.feature_names].values.astype(np.float64)
        return self.rf_model.predict(X)
    
    def predict(self, X, ttop=None):
        """
        Predict MAGT.
        
        If ttop is provided, use it.
        Otherwise, extract from feature matrix.
        """
        if isinstance(X, pd.DataFrame):
            X = X[self.feature_names].values.astype(np.float64)
        
        if ttop is None:
            ttop = self.calculate_ttop_from_features(X)
        
        residual = self.predict_residual(X)
        return ttop + residual
    
    def get_feature_importance(self):
        """Get feature importances as DataFrame."""
        return pd.DataFrame({
            'feature': self.feature_names,
            'importance': self.rf_model.feature_importances_
        }).sort_values('importance', ascending=False)


