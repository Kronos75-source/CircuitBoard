    print("\n" + "=" * 60)
    print("FINAL MODEL: Hybrid TTOP + RandomForest")
    print("=" * 60)
    
    # Check files
    missing = []
    for path, name in [(WANG_RS_PATH, "Wang2018 RS"), (WANG_GT_PATH, "Wang2018 GT"),
                       (GTNP_RS_PATH, "GTN-P RS"), (GTNP_GT_PATH, "GTN-P GT")]:
        if not Path(path).exists():
            missing.append(f"{name}: {path}")
    
    if missing:
        print("\n❌ Missing files:")
        for m in missing:
            print(f"  - {m}")
        exit(1)
    
    Path(OUTPUT_DIR).mkdir(parents=True, exist_ok=True)
    
    try:
        # Load
        df = load_data()
        
        # TTOP
        df = calculate_ttop(df)
        
        # Prepare
        X, y_residual, y_magt, ttop, feature_names, df_clean = prepare_features(df)
        
        # Cross-validation
        cv_results = run_cv(X, y_residual, y_magt, ttop, df_clean)
        
        # Train final
        rf_model = train_final_model(X, y_residual)
        
        # Create hybrid model
        hybrid_model = HybridTTOPRandomForest(rf_model, feature_names)
        
        # Plot
        plot_results(hybrid_model, X, y_magt, ttop, df_clean, cv_results, feature_names, OUTPUT_DIR)
        
        # Save
        save_model(hybrid_model, cv_results, X, y_magt, ttop, df_clean, feature_names, OUTPUT_DIR)
        
    except Exception as e:
        print(f"\n❌ Error: {e}")
        import traceback
        traceback.print_exc()
