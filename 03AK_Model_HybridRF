def save_model(model, cv_results, X, y_magt, ttop, df, feature_names, output_dir):
    """Save final model and results."""
    
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    
    # Save model
    joblib.dump(model.rf_model, output_dir / 'hybrid_rf_model.joblib')
    
    with open(output_dir / 'feature_names.json', 'w') as f:
        json.dump(feature_names, f, indent=2)
    
    print(f"Saved model to: {output_dir / 'hybrid_rf_model.joblib'}")
    
    # Save predictions
    y_pred = model.predict(X, ttop)
    
    df_out = df.copy()
    df_out['TTOP'] = ttop
    df_out['MAGT_pred'] = y_pred
    df_out['residual_true'] = y_magt - ttop
    df_out['residual_pred'] = model.predict_residual(X)
    df_out['error'] = y_pred - y_magt
    
    df_out.to_csv(output_dir / 'final_predictions.csv', index=False)
