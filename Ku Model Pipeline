# DRIVER
# =============================================================================

def main():
    print("=" * 70)
    print("Kudryavtsev ALT pipeline for Alaska CALM sites")
    print("=" * 70)

    # Load inputs
    print("\n[1/5] Loading CALM site metadata...")
    sites_df = pd.read_csv(CONFIG['CALM_SITES_CSV'])
    print(f"  Loaded {len(sites_df)} sites.")
    print(f"  Required columns: site_id, lat, lon, vegetation_class, "
          f"organic_layer_cm, sand_fraction, porosity, water_content")

    print("\n[2/5] Loading CALM ALT observations...")
    obs_df = pd.read_csv(CONFIG['CALM_OBSERVATIONS_CSV'])
    print(f"  Loaded {len(obs_df)} site-year observations.")

    print("\n[3/5] Indexing SNAP temperature rasters...")
    temp_files = find_temp_rasters(CONFIG['SNAP_TEMP_DIR'],
                                     CONFIG['TEMP_FILENAME_PATTERN'])
    print(f"  Found {len(temp_files)} monthly temperature rasters.")
    if len(temp_files) == 0:
        raise RuntimeError(f"No rasters found in {CONFIG['SNAP_TEMP_DIR']} "
                           f"matching pattern {CONFIG['TEMP_FILENAME_PATTERN']}")

    # Snow (optional)
    swe_files = None
    if not CONFIG['USE_LITERATURE_SNOW'] and CONFIG['SNAP_SNOW_DIR']:
        print("  Indexing SWE rasters... (not implemented; using literature)")
        # TODO: implement when SWE product is finalized

    print("\n[4/5] Extracting climate and computing Ku ALT per site-year...")
    climate_df = compute_annual_climate_per_site(sites_df, temp_files, swe_files)
    print(f"  Built climate table with {len(climate_df)} site-year rows.")

    ku_df = compute_ku_alt_per_site_year(climate_df, sites_df)

    print("\n[5/5] Joining with CALM observations and computing residuals...")
    training_table = build_training_table(ku_df, obs_df)
    print(f"  Final training table: {len(training_table)} rows.")
    print(f"  Sites represented: {training_table['site_id'].nunique()}")
    print(f"  Year range: {training_table['year'].min()}-{training_table['year'].max()}")

    # Summary stats
    valid = training_table.dropna(subset=['Ku_ALT_cm', 'alt_observed_cm'])
    if len(valid) > 0:
        print(f"\n  Ku ALT      :  mean={valid['Ku_ALT_cm'].mean():.1f}  "
              f"std={valid['Ku_ALT_cm'].std():.1f} cm")
        print(f"  CALM ALT    :  mean={valid['alt_observed_cm'].mean():.1f}  "
              f"std={valid['alt_observed_cm'].std():.1f} cm")
        print(f"  Residual    :  mean={valid['residual_cm'].mean():+.1f}  "
              f"std={valid['residual_cm'].std():.1f} cm")
        print(f"  Residual |  : MAE={valid['residual_cm'].abs().mean():.1f} cm")

    # Output
    out_path = CONFIG['OUTPUT_CSV']
    os.makedirs(os.path.dirname(out_path), exist_ok=True) if os.path.dirname(out_path) else None
    training_table.to_csv(out_path, index=False)
    print(f"\n  Saved: {out_path}")
    print("\nDone.")


if __name__ == "__main__":
    main()
