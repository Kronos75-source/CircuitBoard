def add_multiyear_averaging(df, window=2):
    """Add rolling averages for climate features."""
    
    print("\n" + "=" * 60)
    print(f"ADDING {window}-YEAR CLIMATE AVERAGING")
    print("=" * 60)
    
    climate_cols = [
        'MAAT_C', 'DDT_Cdays', 'DDF_Cdays', 'FT_ratio',
        'precip_mm_annual', 'SWE_mean_mm', 'SWE_max_mm',
        'SWE_duration_days', 'SWE_winter_mean_mm',
        'LST_summer_C', 'LST_winter_C', 'LST_amplitude_C'
    ]
    
    available_cols = [c for c in climate_cols if c in df.columns]
    print(f"Averaging {len(available_cols)} climate features")
    
    df = df.sort_values(['Code', 'Year'])
    
    for col in available_cols:
        new_col = f'{col}_{window}yr'
        df[new_col] = df.groupby('Code')[col].transform(
            lambda x: x.rolling(window, min_periods=1).mean()
        )
    
    print(f"Added {len(available_cols)} new features with '{window}yr' suffix")
    
    return df, [f'{c}_{window}yr' for c in available_cols]

def prepare_features(df):
    """Prepare features for RF residual learning."""
    
    print("\n" + "=" * 60)
    print("PREPARING FEATURES")
    print("=" * 60)
    
    data = df.copy()
    
    # Calculate residual
    data['residual'] = data['MAGT_100cm'] - data['TTOP']
    
    print(f"Residual stats:")
    print(f"  Mean: {data['residual'].mean():.2f}°C (TTOP bias)")
    print(f"  Std:  {data['residual'].std():.2f}°C")
    
# Features
    feature_cols = [
        'Lat', 'Lon',
        'elevation_m', 'slope_deg', 'northness', 'eastness', 'TPI_500m', 'TWI',
        'organic_carbon_0cm', 'sand_pct', 'clay_pct', 'silt_pct', 'bulk_density',  # NEW: soil
        'landcover_class', 'NDVI_summer_mean', 'NDVI_summer_max', 'NDVI_MODIS_summer',
        'MAAT_C_2yr', 'DDT_Cdays_2yr', 'DDF_Cdays_2yr', 'FT_ratio_2yr',
        'precip_mm_annual_2yr', 'SWE_mean_mm_2yr', 'SWE_max_mm_2yr',
        'SWE_duration_days_2yr', 'SWE_winter_mean_mm_2yr',
        'LST_summer_C_2yr', 'LST_winter_C_2yr', 'LST_amplitude_C_2yr',
    ]
    
    available_features = [c for c in feature_cols if c in data.columns]
    print(f"Features: {len(available_features)}")
    
    # Clean
    for col in available_features + ['residual', 'MAGT_100cm']:
        if col in data.columns:
            data[col] = pd.to_numeric(data[col], errors='coerce')
            data[col] = data[col].replace([-9999, -999.99], np.nan)
            data[col] = data[col].replace([np.inf, -np.inf], np.nan)
    
    # Count before dropping
    n_before = len(data)
    
    data = data.dropna(subset=['residual', 'MAGT_100cm', 'TTOP'])
    data = data.dropna(subset=available_features)
    
    n_after = len(data)
    print(f"Complete cases: {n_after} (dropped {n_before - n_after} with missing data)")
    
    # Breakdown by source
    print(f"\nBy source:")
    for src in data['source'].unique():
        subset = data[data['source'] == src]
        print(f"  {src}: {len(subset)} rows, {subset['Code'].nunique()} sites")
    
    X = data[available_features].values.astype(np.float64)
    y_residual = data['residual'].values
    y_magt = data['MAGT_100cm'].values
    ttop = data['TTOP'].values
    
    return X, y_residual, y_magt, ttop, available_features, data


