                         vmin=-10, vmax=2)
    ax.set_xlabel('Longitude (°E)')
    ax.set_ylabel('Latitude (°N)')
    ax.set_title('Site Distribution (colored by MAGT)')
    plt.colorbar(scatter, label='MAGT (°C)')
    ax.grid(True, alpha=0.3)
    
    output_path = Path(output_dir) / 'site_distribution_panarctic.png'
    plt.savefig(output_path, dpi=150, bbox_inches='tight')
    print(f"Saved site map to: {output_path}")
    plt.close()


# =============================================================================
# 9. SAVE MODEL
# =============================================================================

def save_model(model, cv_results, X, y_magt, ttop, df, feature_names, output_dir):
    """Save final model and results."""
    
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    
    joblib.dump(model.rf_model, output_dir / 'hybrid_rf_model_panarctic.joblib')
    
    with open(output_dir / 'feature_names.json', 'w') as f:
        json.dump(feature_names, f, indent=2)
    
    print(f"Saved model to: {output_dir / 'hybrid_rf_model_panarctic.joblib'}")
    
    y_pred = model.predict(X, ttop)
    
    df_out = df.copy()
    df_out['TTOP'] = ttop
    df_out['MAGT_pred'] = y_pred
    df_out['residual_true'] = y_magt - ttop
    df_out['residual_pred'] = model.predict_residual(X)
    df_out['error'] = y_pred - y_magt
    
    df_out.to_csv(output_dir / 'final_predictions_panarctic.csv', index=False)
    print(f"Saved predictions to: {output_dir / 'final_predictions_panarctic.csv'}")
    
    model.get_feature_importance().to_csv(output_dir / 'feature_importance.csv', index=False)
    
    r2_train = r2_score(y_magt, y_pred)
    rmse_train = np.sqrt(mean_squared_error(y_magt, y_pred))
    
    # Source counts
    source_counts = df['source'].value_counts()
    source_sites = df.groupby('source')['Code'].nunique()
    
    summary = f"""
================================================================================
FINAL MODEL: Hybrid TTOP + RandomForest (Pan-Arctic)
================================================================================

MODEL ARCHITECTURE:
  1. TTOP (physics) provides baseline prediction
  2. RandomForest learns residuals (MAGT - TTOP)
  3. Final: MAGT_pred = TTOP + RF_residual

TTOP FORMULATION:
  TTOP = (nt * DDT - nf * DDF) / 365
  Where:
    nt = 1.0 - 0.3 * NDVI (thawing n-factor)
    nf = 0.7 - 0.3 * (SWE/SWE_max) (freezing n-factor)

RANDOM FOREST:
  Trees: 300
  Max depth: 12
  Features: {len(feature_names)}

DATA SOURCES:
"""
    
    for src in source_counts.index:
        summary += f"  {src}: {source_counts[src]} samples, {source_sites[src]} sites\n"
    
    summary += f"""
  TOTAL: {len(df)} samples, {df['Code'].nunique()} sites

GEOGRAPHIC COVERAGE:
  Latitude:  {df['Lat'].min():.1f}°N to {df['Lat'].max():.1f}°N
  Longitude: {df['Lon'].min():.1f}°E to {df['Lon'].max():.1f}°E

CROSS-VALIDATION RESULTS (Site-Grouped, 5-Fold):
  TTOP only:     R² = {cv_results['TTOP_only']['r2_mean']:.3f} ± {cv_results['TTOP_only']['r2_std']:.3f}
  ML only (RF):  R² = {cv_results['ML_only']['r2_mean']:.3f} ± {cv_results['ML_only']['r2_std']:.3f}
  Hybrid:        R² = {cv_results['Hybrid']['r2_mean']:.3f} ± {cv_results['Hybrid']['r2_std']:.3f}

TRAINING FIT:
  R² = {r2_train:.3f}
  RMSE = {rmse_train:.2f}°C

IMPROVEMENT SUMMARY:
  Previous (Wang2018 + GTN-P Alaska): R² = 0.642
  + Added Pan-Arctic data:            R² = {cv_results['Hybrid']['r2_mean']:.3f} ({cv_results['Hybrid']['r2_mean'] - 0.642:+.3f})

FILES:
  - hybrid_rf_model_panarctic.joblib
  - feature_names.json
  - final_predictions_panarctic.csv
  - feature_importance.csv
  - final_hybrid_rf_panarctic_results.png
  - site_distribution_panarctic.png

================================================================================
"""
    
    with open(output_dir / 'MODEL_README.txt', 'w') as f:
        f.write(summary)
    
    print(f"Saved summary to: {output_dir / 'MODEL_README.txt'}")
    print(summary)


