def get_randomforest():
    """Tuned RandomForest for residual prediction."""
    return RandomForestRegressor(
        n_estimators=300,
        max_depth=8,           # Changed from 12
        min_samples_split=4,
        min_samples_leaf=4,    # Changed from 2
        max_features='sqrt',
        random_state=42,
        n_jobs=-1
    )

# =============================================================================
# 4b. HYPERPARAMETER TUNING
# =============================================================================

def tune_hyperparameters(X, y_residual, groups, n_splits=5):
    """Grid search with GroupKFold for RF hyperparameters."""
    
    print("\n" + "=" * 60)
    print("HYPERPARAMETER TUNING")
    print("=" * 60)
    
    from sklearn.model_selection import GridSearchCV, GroupKFold
    
    param_grid = {
        'n_estimators': [200, 300, 500],
        'max_depth': [8, 12, 16, 20],
        'min_samples_split': [2, 4, 6],
        'min_samples_leaf': [1, 2, 4],
    }
    
    rf = RandomForestRegressor(max_features='sqrt', random_state=42, n_jobs=-1)
    
    group_kfold = GroupKFold(n_splits=n_splits)
    
    grid_search = GridSearchCV(
        rf, 
        param_grid, 
        cv=group_kfold.split(X, y_residual, groups),
        scoring='r2',
        n_jobs=-1,
        verbose=1
    )
    
    grid_search.fit(X, y_residual)
    
    print(f"\nBest parameters: {grid_search.best_params_}")
    print(f"Best CV R²: {grid_search.best_score_:.3f}")
    
    return grid_search.best_params_    

