def load_single_dataset(rs_path, gt_path, source_name, gt_lat_col='Lat', gt_lon_col='Lon'):
    """Load and merge a single RS + ground truth dataset."""
    
    rs = pd.read_csv(rs_path)
    gt = pd.read_csv(gt_path)
    
    rs['Code'] = rs['Code'].astype(str).str.strip()
    gt['Code'] = gt['Code'].astype(str).str.strip()
    
    # Drop rows without MAGT_100cm
    gt = gt.dropna(subset=['MAGT_100cm'])
    
    # Build ground truth columns to merge
    gt_cols = ['Code', 'Year', 'MAGT_100cm']
    
    # Handle various lat/lon column names
    for col in ['Lat', 'latitude', 'lat']:
        if col in gt.columns and 'Lat' not in gt_cols:
            gt = gt.rename(columns={col: 'Lat'})
            gt_cols.append('Lat')
            break
    
    for col in ['Lon', 'longitude', 'lon']:
        if col in gt.columns and 'Lon' not in gt_cols:
            gt = gt.rename(columns={col: 'Lon'})
            gt_cols.append('Lon')
            break
    
    # Merge RS features with ground truth
    merged = pd.merge(rs, gt[gt_cols], on=['Code', 'Year'], how='inner')
    
    # If Lat/Lon came from RS instead of GT, keep them
    if 'Lat' not in merged.columns:
        for col in ['Lat', 'latitude']:
            if col in rs.columns:
                merged['Lat'] = rs[col]
                break
    
    if 'Lon' not in merged.columns:
        for col in ['Lon', 'longitude']:
            if col in rs.columns:
                merged['Lon'] = rs[col]
                break
    
    merged['source'] = source_name
    
    return merged


