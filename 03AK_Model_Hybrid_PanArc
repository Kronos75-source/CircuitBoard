    ax.grid(True, alpha=0.3, axis='x')
    
    # 6: Error by latitude (shows Pan-Arctic spread)
    ax = axes[1, 2]
    errors = y_pred - y_magt
    ax.scatter(df['Lat'].values, errors, c=colors, alpha=0.5, edgecolor='k', linewidth=0.3, s=30)
    ax.axhline(0, color='r', linestyle='--', lw=2)
    ax.set_xlabel('Latitude (°N)')
    ax.set_ylabel('Error (°C)')
    ax.set_title('Prediction Error by Latitude')
    ax.grid(True, alpha=0.3)
    
    plt.tight_layout()
    
    output_path = Path(output_dir) / 'final_hybrid_rf_panarctic_results.png'
    plt.savefig(output_path, dpi=150, bbox_inches='tight')
    print(f"Saved plots to: {output_path}")
    plt.close()
    
    # Additional plot: Geographic distribution
    fig, ax = plt.subplots(figsize=(12, 6))
    scatter = ax.scatter(df['Lon'].values, df['Lat'].values, 
                         c=y_magt, cmap='RdBu_r', 
