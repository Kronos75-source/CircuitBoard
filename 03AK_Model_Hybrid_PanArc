def run_cv(X, y_residual, y_magt, ttop, df, n_splits=5):
    """Cross-validation for Hybrid RF model."""
    
    print("\n" + "=" * 60)
    print("CROSS-VALIDATION")
    print("=" * 60)
    
    groups = df['Code'].values
    unique_sites = df['Code'].nunique()
    n_splits = min(n_splits, unique_sites)
    
    print(f"Sites: {unique_sites}, Folds: {n_splits}")
    
    group_kfold = GroupKFold(n_splits=n_splits)
    
    results = {
        'TTOP_only': {'r2': [], 'rmse': [], 'mae': []},
        'ML_only': {'r2': [], 'rmse': [], 'mae': []},
        'Hybrid': {'r2': [], 'rmse': [], 'mae': []}
    }
    
    all_importances = []
    
    fold = 1
    for train_idx, test_idx in group_kfold.split(X, y_residual, groups):
        X_train, X_test = X[train_idx], X[test_idx]
        y_res_train, y_res_test = y_residual[train_idx], y_residual[test_idx]
        y_magt_train, y_magt_test = y_magt[train_idx], y_magt[test_idx]
        ttop_test = ttop[test_idx]
        
        n_sites_test = len(set(groups[test_idx]))
        print(f"\n--- Fold {fold} ({n_sites_test} sites held out) ---")
        
        # TTOP only
        r2 = r2_score(y_magt_test, ttop_test)
        rmse = np.sqrt(mean_squared_error(y_magt_test, ttop_test))
        mae = mean_absolute_error(y_magt_test, ttop_test)
        results['TTOP_only']['r2'].append(r2)
        results['TTOP_only']['rmse'].append(rmse)
        results['TTOP_only']['mae'].append(mae)
        print(f"  {'TTOP only':15s}: R²={r2:.3f}, RMSE={rmse:.2f}°C")
        
        # ML only
        model_direct = get_randomforest()
        model_direct.fit(X_train, y_magt_train)
        y_pred_direct = model_direct.predict(X_test)
        
        r2 = r2_score(y_magt_test, y_pred_direct)
        rmse = np.sqrt(mean_squared_error(y_magt_test, y_pred_direct))
        mae = mean_absolute_error(y_magt_test, y_pred_direct)
        results['ML_only']['r2'].append(r2)
        results['ML_only']['rmse'].append(rmse)
        results['ML_only']['mae'].append(mae)
        print(f"  {'ML only (RF)':15s}: R²={r2:.3f}, RMSE={rmse:.2f}°C")
        
        # Hybrid
        model_hybrid = get_randomforest()
        model_hybrid.fit(X_train, y_res_train)
        res_pred = model_hybrid.predict(X_test)
        y_pred_hybrid = ttop_test + res_pred
        
        r2 = r2_score(y_magt_test, y_pred_hybrid)
        rmse = np.sqrt(mean_squared_error(y_magt_test, y_pred_hybrid))
        mae = mean_absolute_error(y_magt_test, y_pred_hybrid)
        results['Hybrid']['r2'].append(r2)
        results['Hybrid']['rmse'].append(rmse)
        results['Hybrid']['mae'].append(mae)
        print(f"  {'Hybrid (TTOP+RF)':15s}: R²={r2:.3f}, RMSE={rmse:.2f}°C")
        
        all_importances.append(model_hybrid.feature_importances_)
        
        fold += 1
    
    avg_importances = np.mean(all_importances, axis=0)
    
    # Summary
    print("\n" + "=" * 60)
    print("CROSS-VALIDATION SUMMARY")
    print("=" * 60)
    print(f"\n{'Model':<18} {'R²':>12} {'RMSE (°C)':>14} {'MAE (°C)':>14}")
    print("-" * 60)
    
    for name, display in [('TTOP_only', 'TTOP only'), 
                          ('ML_only', 'ML only (RF)'),
                          ('Hybrid', 'Hybrid TTOP+RF')]:
        r2_mean = np.mean(results[name]['r2'])
        r2_std = np.std(results[name]['r2'])
        rmse_mean = np.mean(results[name]['rmse'])
        rmse_std = np.std(results[name]['rmse'])
        mae_mean = np.mean(results[name]['mae'])
        mae_std = np.std(results[name]['mae'])
        
        print(f"{display:<18} {r2_mean:>5.3f}±{r2_std:<5.3f} {rmse_mean:>6.2f}±{rmse_std:<5.2f} {mae_mean:>6.2f}±{mae_std:<5.2f}")
        
        results[name]['r2_mean'] = r2_mean
        results[name]['r2_std'] = r2_std
        results[name]['rmse_mean'] = rmse_mean
        results[name]['rmse_std'] = rmse_std
        results[name]['mae_mean'] = mae_mean
        results[name]['mae_std'] = mae_std
    
    results['feature_importances'] = avg_importances
    
    return results


