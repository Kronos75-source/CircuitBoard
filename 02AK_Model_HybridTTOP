# 5. CROSS-VALIDATION: HYBRID MODEL
# =============================================================================

def run_hybrid_cv(X, y_residual, y_magt, ttop, feature_names, df, n_splits=5):
    """
    Cross-validation for hybrid TTOP + ML model.
    
    Compares:
    1. TTOP alone
    2. ML alone (predicting MAGT directly)
    3. Hybrid (TTOP + ML residual)
    """
    
    print("\n" + "=" * 60)
    print("HYBRID MODEL CROSS-VALIDATION")
    print("=" * 60)
    
    groups = df['Code'].values
    unique_sites = df['Code'].nunique()
    n_splits = min(n_splits, unique_sites)
    
    print(f"Sites: {unique_sites}, Folds: {n_splits}")
    
    group_kfold = GroupKFold(n_splits=n_splits)
    
    # Results storage
    results = {
        'TTOP_only': {'r2': [], 'rmse': [], 'mae': []},
        'ML_only_XGB': {'r2': [], 'rmse': [], 'mae': []},
        'ML_only_RF': {'r2': [], 'rmse': [], 'mae': []},
        'Hybrid_XGB': {'r2': [], 'rmse': [], 'mae': []},
        'Hybrid_RF': {'r2': [], 'rmse': [], 'mae': []},
        'Hybrid_Ensemble': {'r2': [], 'rmse': [], 'mae': []}
    }
    
    # Track for weight calculation
    all_rmse_xgb = []
    all_rmse_rf = []
    
    fold = 1
    for train_idx, test_idx in group_kfold.split(X, y_residual, groups):
        X_train, X_test = X[train_idx], X[test_idx]
        y_res_train, y_res_test = y_residual[train_idx], y_residual[test_idx]
        y_magt_train, y_magt_test = y_magt[train_idx], y_magt[test_idx]
        ttop_test = ttop[test_idx]
        
        n_sites_test = len(set(groups[test_idx]))
        print(f"\n--- Fold {fold} ({n_sites_test} sites held out) ---")
        
        # ----- TTOP Only -----
        r2 = r2_score(y_magt_test, ttop_test)
        rmse = np.sqrt(mean_squared_error(y_magt_test, ttop_test))
        mae = mean_absolute_error(y_magt_test, ttop_test)
        results['TTOP_only']['r2'].append(r2)
        results['TTOP_only']['rmse'].append(rmse)
        results['TTOP_only']['mae'].append(mae)
        print(f"  {'TTOP only':20s}: R²={r2:.3f}, RMSE={rmse:.2f}°C")
        
        # ----- ML Only (XGBoost predicting MAGT directly) -----
        model_xgb_direct = get_xgboost()
        model_xgb_direct.fit(X_train, y_magt_train)
        y_pred_xgb_direct = model_xgb_direct.predict(X_test)
        
        r2 = r2_score(y_magt_test, y_pred_xgb_direct)
        rmse = np.sqrt(mean_squared_error(y_magt_test, y_pred_xgb_direct))
        mae = mean_absolute_error(y_magt_test, y_pred_xgb_direct)
        results['ML_only_XGB']['r2'].append(r2)
        results['ML_only_XGB']['rmse'].append(rmse)
        results['ML_only_XGB']['mae'].append(mae)
        print(f"  {'ML only (XGB)':20s}: R²={r2:.3f}, RMSE={rmse:.2f}°C")
        
        # ----- ML Only (RandomForest predicting MAGT directly) -----
        model_rf_direct = get_randomforest()
        model_rf_direct.fit(X_train, y_magt_train)
        y_pred_rf_direct = model_rf_direct.predict(X_test)
        
        r2 = r2_score(y_magt_test, y_pred_rf_direct)
        rmse = np.sqrt(mean_squared_error(y_magt_test, y_pred_rf_direct))
        mae = mean_absolute_error(y_magt_test, y_pred_rf_direct)
        results['ML_only_RF']['r2'].append(r2)
        results['ML_only_RF']['rmse'].append(rmse)
        results['ML_only_RF']['mae'].append(mae)
        print(f"  {'ML only (RF)':20s}: R²={r2:.3f}, RMSE={rmse:.2f}°C")
        
        # ----- Hybrid: XGBoost predicting residual -----
        model_xgb_res = get_xgboost()
        model_xgb_res.fit(X_train, y_res_train)
        res_pred_xgb = model_xgb_res.predict(X_test)
        y_pred_hybrid_xgb = ttop_test + res_pred_xgb
        
        r2 = r2_score(y_magt_test, y_pred_hybrid_xgb)
        rmse = np.sqrt(mean_squared_error(y_magt_test, y_pred_hybrid_xgb))
        mae = mean_absolute_error(y_magt_test, y_pred_hybrid_xgb)
        results['Hybrid_XGB']['r2'].append(r2)
        results['Hybrid_XGB']['rmse'].append(rmse)
        results['Hybrid_XGB']['mae'].append(mae)
        all_rmse_xgb.append(rmse)
        print(f"  {'Hybrid (TTOP+XGB)':20s}: R²={r2:.3f}, RMSE={rmse:.2f}°C")
        
        # ----- Hybrid: RandomForest predicting residual -----
        model_rf_res = get_randomforest()
        model_rf_res.fit(X_train, y_res_train)
        res_pred_rf = model_rf_res.predict(X_test)
        y_pred_hybrid_rf = ttop_test + res_pred_rf
        
        r2 = r2_score(y_magt_test, y_pred_hybrid_rf)
        rmse = np.sqrt(mean_squared_error(y_magt_test, y_pred_hybrid_rf))
        mae = mean_absolute_error(y_magt_test, y_pred_hybrid_rf)
        results['Hybrid_RF']['r2'].append(r2)
        results['Hybrid_RF']['rmse'].append(rmse)
        results['Hybrid_RF']['mae'].append(mae)
        all_rmse_rf.append(rmse)
        print(f"  {'Hybrid (TTOP+RF)':20s}: R²={r2:.3f}, RMSE={rmse:.2f}°C")
        
        # ----- Hybrid Ensemble (weighted average of XGB and RF residuals) -----
        # Use inverse RMSE weighting
        rmse_xgb = np.sqrt(mean_squared_error(y_magt_test, y_pred_hybrid_xgb))
        rmse_rf = np.sqrt(mean_squared_error(y_magt_test, y_pred_hybrid_rf))
        w_xgb = (1/rmse_xgb) / (1/rmse_xgb + 1/rmse_rf)
        w_rf = (1/rmse_rf) / (1/rmse_xgb + 1/rmse_rf)
        
        res_pred_ensemble = w_xgb * res_pred_xgb + w_rf * res_pred_rf
        y_pred_hybrid_ens = ttop_test + res_pred_ensemble
        
        r2 = r2_score(y_magt_test, y_pred_hybrid_ens)
        rmse = np.sqrt(mean_squared_error(y_magt_test, y_pred_hybrid_ens))
        mae = mean_absolute_error(y_magt_test, y_pred_hybrid_ens)
        results['Hybrid_Ensemble']['r2'].append(r2)
        results['Hybrid_Ensemble']['rmse'].append(rmse)
        results['Hybrid_Ensemble']['mae'].append(mae)
        print(f"  {'Hybrid (Ensemble)':20s}: R²={r2:.3f}, RMSE={rmse:.2f}°C  [XGB:{w_xgb:.2f}, RF:{w_rf:.2f}]")
        
        fold += 1
    
    # Calculate global weights
    mean_rmse_xgb = np.mean(all_rmse_xgb)
    mean_rmse_rf = np.mean(all_rmse_rf)
    global_w_xgb = (1/mean_rmse_xgb) / (1/mean_rmse_xgb + 1/mean_rmse_rf)
    global_w_rf = (1/mean_rmse_rf) / (1/mean_rmse_xgb + 1/mean_rmse_rf)
    
    results['global_weights'] = {'XGBoost': global_w_xgb, 'RandomForest': global_w_rf}
    
    # Summary
    print("\n" + "=" * 60)
    print("CROSS-VALIDATION SUMMARY")
    print("=" * 60)
    print(f"\n{'Model':<22} {'R²':>12} {'RMSE (°C)':>14} {'MAE (°C)':>14}")
    print("-" * 64)
    
    model_order = ['TTOP_only', 'ML_only_XGB', 'ML_only_RF', 'Hybrid_XGB', 'Hybrid_RF', 'Hybrid_Ensemble']
    display_names = ['TTOP only', 'ML only (XGB)', 'ML only (RF)', 'Hybrid TTOP+XGB', 'Hybrid TTOP+RF', 'Hybrid Ensemble']
    
    for name, display in zip(model_order, display_names):
        r2_mean = np.mean(results[name]['r2'])
        r2_std = np.std(results[name]['r2'])
        rmse_mean = np.mean(results[name]['rmse'])
        rmse_std = np.std(results[name]['rmse'])
        mae_mean = np.mean(results[name]['mae'])
        mae_std = np.std(results[name]['mae'])
        
        print(f"{display:<22} {r2_mean:>5.3f}±{r2_std:<5.3f} {rmse_mean:>6.2f}±{rmse_std:<5.2f} {mae_mean:>6.2f}±{mae_std:<5.2f}")
        
        results[name]['r2_mean'] = r2_mean
        results[name]['r2_std'] = r2_std
        results[name]['rmse_mean'] = rmse_mean
        results[name]['rmse_std'] = rmse_std
        results[name]['mae_mean'] = mae_mean
        results[name]['mae_std'] = mae_std
    
    print(f"\nOptimal weights: XGBoost={global_w_xgb:.3f}, RandomForest={global_w_rf:.3f}")
    
    # Find best model
    best_model = max(model_order, key=lambda x: results[x]['r2_mean'])
    print(f"Best model: {best_model} (R² = {results[best_model]['r2_mean']:.3f})")
    
    return results


