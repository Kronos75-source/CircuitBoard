# 9. SAVE RESULTS
# =============================================================================

def save_results(hybrid_model, cv_results, X, y_magt, ttop, df, feature_names, output_dir):
    """Save hybrid model and results."""
    
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    
    # Save models
    hybrid_model.models['XGBoost'].save_model(output_dir / 'hybrid_xgboost_residual.json')
    joblib.dump(hybrid_model.models['RandomForest'], output_dir / 'hybrid_rf_residual.joblib')
    
    with open(output_dir / 'hybrid_weights.json', 'w') as f:
        json.dump(hybrid_model.weights, f, indent=2)
    
    with open(output_dir / 'feature_names.json', 'w') as f:
        json.dump(feature_names, f, indent=2)
    
    print(f"Saved models to {output_dir}")
    
    # Save predictions
    components = hybrid_model.predict_components(X, ttop)
    
    df_out = df.copy()
    df_out['TTOP'] = ttop
    df_out['residual_true'] = y_magt - ttop
    df_out['residual_pred'] = components['residual_ensemble']
    df_out['MAGT_pred_hybrid'] = components['MAGT_pred']
    df_out['error_TTOP'] = ttop - y_magt
    df_out['error_hybrid'] = components['MAGT_pred'] - y_magt
    
    df_out.to_csv(output_dir / 'hybrid_predictions.csv', index=False)
    print(f"Saved predictions to: {output_dir / 'hybrid_predictions.csv'}")
    
    # Summary
    summary_lines = [
        "Hybrid TTOP + ML Model",
        "=" * 50,
        "",
        "APPROACH:",
        "  1. TTOP provides physics-based baseline",
        "  2. ML ensemble learns residuals (MAGT - TTOP)",
        "  3. Final: MAGT_pred = TTOP + ML_residual",
        "",
        f"Weights: XGBoost={hybrid_model.weights['XGBoost']:.3f}, RF={hybrid_model.weights['RandomForest']:.3f}",
        "",
        "CROSS-VALIDATION RESULTS:",
        "-" * 50,
    ]
    
    for name, display in [('TTOP_only', 'TTOP only'), 
                          ('ML_only_RF', 'ML only (RF)'),
                          ('Hybrid_Ensemble', 'Hybrid (TTOP+ML)')]:
        r = cv_results[name]
        summary_lines.append(f"  {display:<20}: R²={r['r2_mean']:.3f}±{r['r2_std']:.3f}, RMSE={r['rmse_mean']:.2f}±{r['rmse_std']:.2f}°C")
    
    # Calculate improvement
    ttop_r2 = cv_results['TTOP_only']['r2_mean']
    ml_r2 = cv_results['ML_only_RF']['r2_mean']
    hybrid_r2 = cv_results['Hybrid_Ensemble']['r2_mean']
    
    summary_lines.extend([
        "",
        "IMPROVEMENT:",
        f"  TTOP baseline:      R² = {ttop_r2:.3f}",
        f"  ML only:            R² = {ml_r2:.3f}",
        f"  Hybrid:             R² = {hybrid_r2:.3f}",
        f"  Gain over TTOP:     +{hybrid_r2 - ttop_r2:.3f}",
        f"  Gain over ML only:  {hybrid_r2 - ml_r2:+.3f}",
    ])
    
    with open(output_dir / 'hybrid_summary.txt', 'w') as f:
        f.write('\n'.join(summary_lines))
    
    print(f"Saved summary to: {output_dir / 'hybrid_summary.txt'}")


