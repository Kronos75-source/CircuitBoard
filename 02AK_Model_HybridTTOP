# =============================================================================
# 2. CALCULATE TTOP (Version 1 - Best performer)
# =============================================================================

def calculate_ttop(df):
    """
    TTOP v1: Classic Smith & Riseborough formulation
    
    TTOP = (nt * DDT - nf * DDF) / P
    
    Returns TTOP predictions and the estimated n-factors for transparency.
    """
    
    print("\n" + "=" * 60)
    print("CALCULATING TTOP (Physics Baseline)")
    print("=" * 60)
    
    data = df.copy()
    
    # Clean required columns
    for col in ['DDT_Cdays', 'DDF_Cdays', 'NDVI_summer_mean', 'SWE_winter_mean_mm']:
        if col in data.columns:
            data[col] = pd.to_numeric(data[col], errors='coerce')
            data[col] = data[col].replace([-9999, -999.99], np.nan)
    
    # Estimate n-factors from available data
    # nt (thawing n-factor): More vegetation = lower nt (shading effect)
    ndvi = data['NDVI_summer_mean'].fillna(0.3).clip(0, 1)
    nt = 1.0 - 0.3 * ndvi  # Range: 0.7 - 1.0
    
    # nf (freezing n-factor): More snow = lower nf (insulation effect)
    swe = data['SWE_winter_mean_mm'].fillna(50)
    swe_max = swe.max() if swe.max() > 0 else 1
    nf = 0.7 - 0.3 * (swe / swe_max).clip(0, 1)  # Range: 0.4 - 0.7
    
    # Calculate TTOP
    P = 365  # days
    ttop = (nt * data['DDT_Cdays'] - nf * data['DDF_Cdays']) / P
    
    print(f"  n_t (thawing):  mean={nt.mean():.3f}, range=[{nt.min():.3f}, {nt.max():.3f}]")
    print(f"  n_f (freezing): mean={nf.mean():.3f}, range=[{nf.min():.3f}, {nf.max():.3f}]")
    print(f"  TTOP range: {ttop.min():.2f} to {ttop.max():.2f}°C")
    
    # Store n-factors for potential use as features
    data['TTOP'] = ttop
    data['nt'] = nt
    data['nf'] = nf
    
    return data


# =============================================================================
# 3. PREPARE FEATURES FOR RESIDUAL LEARNING
# =============================================================================

def prepare_features(df):
    """
    Prepare features for ML residual learning.
    
    Target: residual = MAGT_observed - TTOP
    Features: All RS features + TTOP + n-factors
    """
    
    print("\n" + "=" * 60)
    print("PREPARING FEATURES FOR RESIDUAL LEARNING")
    print("=" * 60)
    
    data = df.copy()
    
    # Calculate residual (what TTOP misses)
    data['residual'] = data['MAGT_100cm'] - data['TTOP']
    
    print(f"Residual stats:")
    print(f"  Mean: {data['residual'].mean():.2f}°C (TTOP bias)")
    print(f"  Std:  {data['residual'].std():.2f}°C")
    print(f"  Range: {data['residual'].min():.2f} to {data['residual'].max():.2f}°C")
    
    # Define features
    # Include TTOP and n-factors so ML can learn to correct them
    feature_cols = [
        # Terrain
        'elevation_m', 'slope_deg', 'northness', 'eastness', 'TPI_500m', 'TWI',
        # Vegetation
        'landcover_class', 'NDVI_summer_mean', 'NDVI_summer_max', 'NDVI_MODIS_summer',
        # Climate
        'MAAT_C', 'DDT_Cdays', 'DDF_Cdays', 'FT_ratio',
        'precip_mm_annual', 'SWE_mean_mm', 'SWE_max_mm',
        'SWE_duration_days', 'SWE_winter_mean_mm',
        # LST
        'LST_summer_C', 'LST_winter_C', 'LST_amplitude_C',
        # TTOP components (so ML can learn corrections)
        'TTOP', 'nt', 'nf'
    ]
    
    available_features = [c for c in feature_cols if c in data.columns]
    print(f"\nAvailable features: {len(available_features)}")
    
    # Clean data
    for col in available_features + ['residual', 'MAGT_100cm']:
        if col in data.columns:
            data[col] = pd.to_numeric(data[col], errors='coerce')
            data[col] = data[col].replace([-9999, -999.99], np.nan)
            data[col] = data[col].replace([np.inf, -np.inf], np.nan)
    
    # Drop rows with missing target or features
    data = data.dropna(subset=['residual', 'MAGT_100cm', 'TTOP'])
    data = data.dropna(subset=available_features)
    
    print(f"Complete cases: {len(data)}")
    print(f"  Wang2018: {len(data[data['source'] == 'Wang2018'])} rows")
    print(f"  GTN-P: {len(data[data['source'] == 'GTN-P'])} rows")
    
    X = data[available_features].values.astype(np.float64)
    y_residual = data['residual'].values
    y_magt = data['MAGT_100cm'].values
    ttop = data['TTOP'].values
    
    print(f"\nFinal X shape: {X.shape}")
    print(f"Residual range: {y_residual.min():.2f} to {y_residual.max():.2f}°C")
    
    return X, y_residual, y_magt, ttop, available_features, data


