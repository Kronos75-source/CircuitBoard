# =============================================================================
# 7. HYBRID MODEL CLASS
# =============================================================================

class HybridTTOPModel:
    """
    Hybrid physics-ML model.
    
    Prediction = TTOP + weighted_ensemble(ML_residuals)
    """
    
    def __init__(self, models, weights, feature_names):
        self.models = models
        self.weights = weights
        self.feature_names = feature_names
    
    def predict_residual(self, X):
        """Predict the residual (MAGT - TTOP)."""
        if isinstance(X, pd.DataFrame):
            X = X.values.astype(np.float64)
        else:
            X = X.astype(np.float64)
        
        res_xgb = self.models['XGBoost'].predict(X)
        res_rf = self.models['RandomForest'].predict(X)
        
        return (self.weights['XGBoost'] * res_xgb + 
                self.weights['RandomForest'] * res_rf)
    
    def predict(self, X, ttop):
        """Predict MAGT = TTOP + ML_residual."""
        residual = self.predict_residual(X)
        return ttop + residual
    
    def predict_components(self, X, ttop):
        """Get all prediction components for analysis."""
        if isinstance(X, pd.DataFrame):
            X = X.values.astype(np.float64)
        else:
            X = X.astype(np.float64)
        
        res_xgb = self.models['XGBoost'].predict(X)
        res_rf = self.models['RandomForest'].predict(X)
        res_ensemble = self.weights['XGBoost'] * res_xgb + self.weights['RandomForest'] * res_rf
        
        return {
            'TTOP': ttop,
            'residual_XGBoost': res_xgb,
            'residual_RF': res_rf,
            'residual_ensemble': res_ensemble,
            'MAGT_pred': ttop + res_ensemble
        }


