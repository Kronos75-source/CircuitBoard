def plot_hybrid_results(hybrid_model, X, y_magt, ttop, df, cv_results, output_dir):
    """Generate diagnostic plots for hybrid model."""
    
    print("\n" + "=" * 60)
    print("GENERATING PLOTS")
    print("=" * 60)
    
    components = hybrid_model.predict_components(X, ttop)
    y_pred = components['MAGT_pred']
    
    fig, axes = plt.subplots(2, 3, figsize=(15, 10))
    
    colors = df['source'].map({'Wang2018': 'steelblue', 'GTN-P': 'orange'}).values
    
    # 1: TTOP only
    ax = axes[0, 0]
    ax.scatter(y_magt, ttop, alpha=0.5, edgecolor='k', linewidth=0.3, s=30, c=colors)
    ax.plot([y_magt.min(), y_magt.max()], [y_magt.min(), y_magt.max()], 'r--', lw=2)
    r2 = r2_score(y_magt, ttop)
    rmse = np.sqrt(mean_squared_error(y_magt, ttop))
    ax.set_xlabel('Observed MAGT (°C)')
    ax.set_ylabel('Predicted MAGT (°C)')
    ax.set_title(f'TTOP Only (Physics)\nR²={r2:.3f}, RMSE={rmse:.2f}°C')
    ax.grid(True, alpha=0.3)
    
    # 2: Hybrid model
    ax = axes[0, 1]
    ax.scatter(y_magt, y_pred, alpha=0.5, edgecolor='k', linewidth=0.3, s=30, c=colors)
    ax.plot([y_magt.min(), y_magt.max()], [y_magt.min(), y_magt.max()], 'r--', lw=2)
    r2 = r2_score(y_magt, y_pred)
    rmse = np.sqrt(mean_squared_error(y_magt, y_pred))
    ax.set_xlabel('Observed MAGT (°C)')
    ax.set_ylabel('Predicted MAGT (°C)')
    ax.set_title(f'Hybrid (TTOP + ML Residual)\nR²={r2:.3f}, RMSE={rmse:.2f}°C')
    ax.grid(True, alpha=0.3)
    
    from matplotlib.patches import Patch
    legend_elements = [Patch(facecolor='steelblue', label='Wang2018'),
                       Patch(facecolor='orange', label='GTN-P')]
    ax.legend(handles=legend_elements, loc='lower right')
    
    # 3: Residual learned by ML
    ax = axes[0, 2]
    true_residual = y_magt - ttop
    pred_residual = components['residual_ensemble']
    ax.scatter(true_residual, pred_residual, alpha=0.5, edgecolor='k', linewidth=0.3, s=30, c=colors)
    ax.plot([true_residual.min(), true_residual.max()], 
            [true_residual.min(), true_residual.max()], 'r--', lw=2)
    r2_res = r2_score(true_residual, pred_residual)
    ax.set_xlabel('True Residual (MAGT - TTOP) (°C)')
    ax.set_ylabel('Predicted Residual (°C)')
    ax.set_title(f'ML Residual Learning\nR²={r2_res:.3f}')
    ax.grid(True, alpha=0.3)
    
    # 4: CV comparison
    ax = axes[1, 0]
    models = ['TTOP_only', 'ML_only_RF', 'Hybrid_Ensemble']
    display = ['TTOP Only', 'ML Only', 'Hybrid']
    r2_means = [cv_results[m]['r2_mean'] for m in models]
    r2_stds = [cv_results[m]['r2_std'] for m in models]
    bar_colors = ['gray', 'steelblue', 'crimson']
    
    bars = ax.bar(display, r2_means, yerr=r2_stds, capsize=5, color=bar_colors, alpha=0.8)
    ax.set_ylabel('R² (Site-Grouped CV)')
    ax.set_title('Model Comparison')
    ax.set_ylim(0, 1)
    ax.grid(True, alpha=0.3, axis='y')
    
    for bar, mean in zip(bars, r2_means):
        ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.02,
                f'{mean:.3f}', ha='center', va='bottom', fontsize=11)
    
    # 5: Improvement from TTOP to Hybrid
    ax = axes[1, 1]
    improvement = y_pred - ttop  # How much ML corrected
    error_ttop = ttop - y_magt
    error_hybrid = y_pred - y_magt
    
    ax.scatter(error_ttop, error_hybrid, alpha=0.5, edgecolor='k', linewidth=0.3, s=30, c=colors)
    ax.axhline(0, color='r', linestyle='--', lw=1)
    ax.axvline(0, color='r', linestyle='--', lw=1)
    ax.plot([-6, 6], [-6, 6], 'k:', alpha=0.5)  # No improvement line
    ax.set_xlabel('TTOP Error (°C)')
    ax.set_ylabel('Hybrid Error (°C)')
    ax.set_title('Error Reduction\n(points below diagonal = improvement)')
    ax.set_xlim(-6, 6)
    ax.set_ylim(-6, 6)
    ax.grid(True, alpha=0.3)
    
    # 6: Residuals by MAAT
    ax = axes[1, 2]
    residuals_ttop = ttop - y_magt
    residuals_hybrid = y_pred - y_magt
    
    ax.scatter(df['MAAT_C'].values, residuals_ttop, alpha=0.4, s=20, c='gray', label='TTOP')
    ax.scatter(df['MAAT_C'].values, residuals_hybrid, alpha=0.4, s=20, c='crimson', label='Hybrid')
    ax.axhline(0, color='k', linestyle='--', lw=1)
    ax.set_xlabel('MAAT (°C)')
    ax.set_ylabel('Residual (°C)')
    ax.set_title('Residuals by Air Temperature')
    ax.legend()
    ax.grid(True, alpha=0.3)
    
    plt.tight_layout()
    
    output_path = Path(output_dir) / 'hybrid_ttop_ml_diagnostic.png'
    plt.savefig(output_path, dpi=150, bbox_inches='tight')
    print(f"Saved plots to: {output_path}")
    plt.close()


