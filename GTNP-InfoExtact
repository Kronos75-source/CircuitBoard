def generate_report(df_wide: pd.DataFrame, df_meta: pd.DataFrame, 
                    output_path: str, year_range: tuple):
    """Generate a text report summarizing the processed data."""
    
    lines = [
        "GTN-P Data Processing Report",
        "=" * 50,
        f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}",
        "",
        "INPUT DATA",
        "-" * 50,
        f"Metadata entries: {len(df_meta)}",
        f"Unique boreholes in metadata: {df_meta['borehole_id'].nunique()}",
        "",
        "OUTPUT DATA",
        "-" * 50,
        f"Total site-year records: {len(df_wide)}",
        f"Unique sites (Code): {df_wide['Code'].nunique()}",
        f"Year range: {df_wide['Year'].min()} - {df_wide['Year'].max()}",
        "",
        "MAGT COVERAGE BY DEPTH",
        "-" * 50,
    ]
    
    magt_cols = [c for c in df_wide.columns if c.startswith('MAGT_')]
    for col in sorted(magt_cols):
        n = df_wide[col].notna().sum()
        pct = 100 * n / len(df_wide)
        lines.append(f"  {col}: {n} records ({pct:.1f}%)")
    
    lines.extend([
        "",
        "GEOGRAPHIC COVERAGE",
        "-" * 50,
        f"Latitude range: {df_wide['latitude'].min():.3f} to {df_wide['latitude'].max():.3f}",
        f"Longitude range: {df_wide['longitude'].min():.3f} to {df_wide['longitude'].max():.3f}",
        "",
        "NEXT STEPS",
        "-" * 50,
        "1. Use gtnp_site_metadata.csv for GEE RS feature extraction",
        "2. Extract features for years: " + str(year_range),
        "3. Merge RS features with gtnp_annual_summary.csv on Code + Year",
        "4. Combine with existing training data",
        "5. Retrain ensemble model",
    ])
    
    report = "\n".join(lines)
    
    with open(output_path, 'w') as f:
        f.write(report)
    
    print(f"\nSaved processing report to: {output_path}")
    print("\n" + report)


