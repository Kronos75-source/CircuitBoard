# MAIN
# =============================================================================

def main():
    """Run the full processing pipeline."""
    
    print("\n" + "=" * 60)
    print("GTN-P DATA PROCESSOR")
    print("=" * 60)
    
    # Check files exist
    if not Path(METADATA_JSON).exists():
        print(f"ERROR: Metadata file not found: {METADATA_JSON}")
        print("Make sure this script is in the same folder as your data files.")
        return
    
    if not Path(TEMP_DATA_CSV).exists():
        print(f"ERROR: Temperature data not found: {TEMP_DATA_CSV}")
        return
    
    # Create output directory
    Path(OUTPUT_DIR).mkdir(parents=True, exist_ok=True)
    
    # Load data
    df_meta = load_metadata(METADATA_JSON)
    df_temp = load_temperature_data(TEMP_DATA_CSV)
    
    # Process to annual MAGT
    df_annual = process_to_annual_magt(
        df_temp=df_temp,
        df_meta=df_meta,
        target_depths=TARGET_DEPTHS,
        depth_tolerance=DEPTH_TOLERANCE,
        min_days=MIN_DAYS_PER_YEAR,
        year_range=YEAR_RANGE
    )
    
    if len(df_annual) == 0:
        print("\nNo data processed. Check your input files and parameters.")
        return
    
    # Pivot to model format
    df_wide = pivot_to_model_format(df_annual)
    
    # Save outputs
    annual_path = Path(OUTPUT_DIR) / ANNUAL_SUMMARY_OUTPUT
    df_wide.to_csv(annual_path, index=False)
    print(f"\nSaved annual summary to: {annual_path}")
    
    # Export site metadata for GEE
    sites_path = Path(OUTPUT_DIR) / SITE_METADATA_OUTPUT
    export_site_metadata(df_wide, sites_path)
    
    # Generate report
    report_path = Path(OUTPUT_DIR) / PROCESSING_REPORT
    generate_report(df_wide, df_meta, report_path, YEAR_RANGE)
    
    print("\n" + "=" * 60)
    print("PROCESSING COMPLETE")
    print("=" * 60)
    print(f"\nOutput files:")
    print(f"  1. {ANNUAL_SUMMARY_OUTPUT} - Annual MAGT for model training")
    print(f"  2. {SITE_METADATA_OUTPUT} - Site coordinates for GEE extraction")
    print(f"  3. {PROCESSING_REPORT} - Summary report")


if __name__ == "__main__":
    main()
