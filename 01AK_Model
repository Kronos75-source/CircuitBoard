def combine_datasets(wang_df: pd.DataFrame, gtnp_df: pd.DataFrame) -> pd.DataFrame:
    """Combine Wang2018 and GTN-P datasets with consistent columns."""
    
    print("\n" + "=" * 60)
    print("COMBINING DATASETS")
    print("=" * 60)
    
    # Define the columns we need
    required_cols = [
        'Code', 'Year', 'Lat', 'Lon', 'source',
        'MAGT_100cm',
        'elevation_m', 'slope_deg', 'northness', 'eastness', 'TPI_500m', 'TWI',
        'landcover_class',
        'NDVI_summer_mean', 'NDVI_summer_max', 'NDVI_MODIS_summer',
        'MAAT_C', 'DDT_Cdays', 'DDF_Cdays', 'FT_ratio',
        'precip_mm_annual', 'SWE_mean_mm', 'SWE_max_mm',
        'SWE_duration_days', 'SWE_winter_mean_mm',
        'LST_summer_C', 'LST_winter_C', 'LST_amplitude_C'
    ]
    
    # Select columns that exist in each dataset
    wang_cols = [c for c in required_cols if c in wang_df.columns]
    gtnp_cols = [c for c in required_cols if c in gtnp_df.columns]
    
    wang_subset = wang_df[wang_cols].copy()
    gtnp_subset = gtnp_df[gtnp_cols].copy()
    
    # Combine
    combined = pd.concat([wang_subset, gtnp_subset], ignore_index=True)
    
    print(f"\nWang2018: {len(wang_subset)} rows, {wang_subset['Code'].nunique()} sites")
    print(f"GTN-P:    {len(gtnp_subset)} rows, {gtnp_subset['Code'].nunique()} sites")
    print(f"Combined: {len(combined)} rows, {combined['Code'].nunique()} sites")
    print(f"Year range: {combined['Year'].min()} - {combined['Year'].max()}")
    
    # Check for column mismatches
    missing_wang = set(required_cols) - set(wang_cols)
    missing_gtnp = set(required_cols) - set(gtnp_cols)
    if missing_wang:
        print(f"\nWarning - Wang2018 missing columns: {missing_wang}")
    if missing_gtnp:
        print(f"Warning - GTN-P missing columns: {missing_gtnp}")
    
    return combined


