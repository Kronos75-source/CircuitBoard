def prepare_features(df: pd.DataFrame) -> tuple:
    """Clean data and prepare feature matrix X and target y."""
    
    print("\n" + "=" * 60)
    print("PREPARING FEATURES")
    print("=" * 60)
    
    feature_cols = [
        'elevation_m', 'slope_deg', 'northness', 'eastness', 'TPI_500m', 'TWI',
        'landcover_class',
        'NDVI_summer_mean', 'NDVI_summer_max', 'NDVI_MODIS_summer',
        'MAAT_C', 'DDT_Cdays', 'DDF_Cdays', 'FT_ratio',
        'precip_mm_annual', 'SWE_mean_mm', 'SWE_max_mm',
        'SWE_duration_days', 'SWE_winter_mean_mm',
        'LST_summer_C', 'LST_winter_C', 'LST_amplitude_C'
    ]
    
    available_features = [c for c in feature_cols if c in df.columns]
    print(f"Available features: {len(available_features)}")
    
    target_col = 'MAGT_100cm'
    data = df.copy()
    
    # Clean missing values
    for col in available_features + [target_col]:
        if col in data.columns:
            data[col] = pd.to_numeric(data[col], errors='coerce')
            data[col] = data[col].replace(-9999, np.nan)
            data[col] = data[col].replace(-999.99, np.nan)
    
    # Count before dropping
    n_before = len(data)
    n_with_target = data[target_col].notna().sum()
    
    data = data.dropna(subset=[target_col])
    data = data.dropna(subset=available_features)
    
    print(f"Rows with MAGT_100cm: {n_with_target}")
    print(f"Complete cases: {len(data)}")
    
    # Report by source
    for src in data['source'].unique():
        n = len(data[data['source'] == src])
        sites = data[data['source'] == src]['Code'].nunique()
        print(f"  {src}: {n} rows, {sites} sites")
    
    X = data[available_features].values.astype(np.float64)
    y = data[target_col].values
    
    print(f"\nFinal X shape: {X.shape}")
    print(f"Target range: {y.min():.2f} to {y.max():.2f} °C")
    
    return X, y, available_features, data


