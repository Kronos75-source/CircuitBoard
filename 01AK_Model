def load_gtnp(rs_path: str, gt_path: str) -> pd.DataFrame:
    """Load GTN-P RS features and ground temperature data."""
    
    print("-" * 40)
    print("Loading GTN-P dataset...")
    print("-" * 40)
    
    rs = pd.read_csv(rs_path)
    gt = pd.read_csv(gt_path)
    
    print(f"  RS features: {len(rs)} rows, columns: {list(rs.columns)}")
    print(f"  Ground temp: {len(gt)} rows, columns: {list(gt.columns)}")
    
    rs['Code'] = rs['Code'].astype(str).str.strip()
    gt['Code'] = gt['Code'].astype(str).str.strip()
    rs['Year'] = rs['Year'].astype(int)
    gt['Year'] = gt['Year'].astype(int)
    
    # GTN-P ground temp file has different structure - select what we need
    gt_cols = ['Code', 'Year', 'MAGT_100cm']
    # Add Lat/Lon if available (might be in RS file instead)
    for col in ['latitude', 'longitude', 'Lat', 'Lon']:
        if col in gt.columns:
            gt_cols.append(col)
    
    gt_subset = gt[gt_cols].copy()
    
    # Drop rows without MAGT_100cm
    gt_subset = gt_subset.dropna(subset=['MAGT_100cm'])
    
    merged = pd.merge(rs, gt_subset, on=['Code', 'Year'], how='inner')
    
    # Standardize Lat/Lon column names
    if 'latitude' in merged.columns and 'Lat' not in merged.columns:
        merged['Lat'] = merged['latitude']
    if 'longitude' in merged.columns and 'Lon' not in merged.columns:
        merged['Lon'] = merged['longitude']
    
    # Add source label
    merged['source'] = 'GTN-P'
    
    print(f"  Merged: {len(merged)} rows, {merged['Code'].nunique()} sites")
    
    return merged


