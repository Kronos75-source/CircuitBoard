# =============================================================================
# 8. ENSEMBLE PREDICTION CLASS
# =============================================================================

class WeightedEnsembleModel:
    """Weighted averaging ensemble wrapper for XGBoost + RandomForest."""
    
    def __init__(self, models: dict, weights: dict, feature_names: list):
        self.models = models
        self.weights = weights
        self.feature_names = feature_names
    
    def predict(self, X) -> np.ndarray:
        """Weighted average predictions from both models."""
        if isinstance(X, pd.DataFrame):
            X = X.values.astype(np.float64)
        else:
            X = X.astype(np.float64)
        
        pred_xgb = self.models['XGBoost'].predict(X)
        pred_rf = self.models['RandomForest'].predict(X)
        
        return (self.weights['XGBoost'] * pred_xgb +
                self.weights['RandomForest'] * pred_rf)
    
    def predict_individual(self, X) -> dict:
        """Get predictions from each model separately."""
        if isinstance(X, pd.DataFrame):
            X = X.values.astype(np.float64)
        else:
            X = X.astype(np.float64)
        
        return {
            'XGBoost': self.models['XGBoost'].predict(X),
            'RandomForest': self.models['RandomForest'].predict(X)
        }


