    ax.set_ylabel('Predicted MAGT (°C)')
    ax.set_title(f'XGBoost\nR²={r2:.3f}, RMSE={rmse:.2f}°C')
    ax.grid(True, alpha=0.3)
    
    # 2: RandomForest predictions vs observed
