# 6. CROSS-VALIDATION WITH ENSEMBLE
# =============================================================================

def run_ensemble_cv(X: np.ndarray, y: np.ndarray,
                    feature_names: list, df: pd.DataFrame,
                    n_splits: int = 5) -> dict:
    """
    Run grouped cross-validation for each model and the ensemble.
    Calculates optimal weights based on inverse RMSE.
    """
    
    print("\n" + "=" * 60)
    print("ENSEMBLE CROSS-VALIDATION")
    print("=" * 60)
    
    groups = df['Code'].values
    unique_sites = df['Code'].nunique()
    n_splits = min(n_splits, unique_sites)
    
    print(f"Sites: {unique_sites}, Folds: {n_splits}")
    
    group_kfold = GroupKFold(n_splits=n_splits)
    
    # Storage for results
    model_names = ['XGBoost', 'RandomForest', 'Ensemble_Equal', 'Ensemble_Weighted']
    results = {name: {'r2': [], 'rmse': [], 'mae': []} for name in model_names}
    
    # Track RMSE for weight calculation
    all_rmse_xgb = []
    all_rmse_rf = []
    
    fold = 1
    for train_idx, test_idx in group_kfold.split(X, y, groups):
        X_train, X_test = X[train_idx], X[test_idx]
        y_train, y_test = y[train_idx], y[test_idx]
        
        n_sites_test = len(set(groups[test_idx]))
        print(f"\n--- Fold {fold} ({n_sites_test} sites held out) ---")
        
        # XGBoost
        model_xgb = get_xgboost()
        model_xgb.fit(X_train, y_train)
        y_pred_xgb = model_xgb.predict(X_test)
        
        r2 = r2_score(y_test, y_pred_xgb)
        rmse = np.sqrt(mean_squared_error(y_test, y_pred_xgb))
        mae = mean_absolute_error(y_test, y_pred_xgb)
        results['XGBoost']['r2'].append(r2)
        results['XGBoost']['rmse'].append(rmse)
        results['XGBoost']['mae'].append(mae)
        all_rmse_xgb.append(rmse)
        print(f"  {'XGBoost':18s}: R²={r2:.3f}, RMSE={rmse:.2f}°C, MAE={mae:.2f}°C")
        
        # Random Forest
        model_rf = get_randomforest()
        model_rf.fit(X_train, y_train)
        y_pred_rf = model_rf.predict(X_test)
        
        r2 = r2_score(y_test, y_pred_rf)
        rmse = np.sqrt(mean_squared_error(y_test, y_pred_rf))
        mae = mean_absolute_error(y_test, y_pred_rf)
        results['RandomForest']['r2'].append(r2)
        results['RandomForest']['rmse'].append(rmse)
        results['RandomForest']['mae'].append(mae)
        all_rmse_rf.append(rmse)
        print(f"  {'RandomForest':18s}: R²={r2:.3f}, RMSE={rmse:.2f}°C, MAE={mae:.2f}°C")
        
        # Ensemble: equal weights (0.5, 0.5)
        y_pred_equal = 0.5 * y_pred_xgb + 0.5 * y_pred_rf
        
        r2 = r2_score(y_test, y_pred_equal)
        rmse = np.sqrt(mean_squared_error(y_test, y_pred_equal))
        mae = mean_absolute_error(y_test, y_pred_equal)
        results['Ensemble_Equal']['r2'].append(r2)
        results['Ensemble_Equal']['rmse'].append(rmse)
        results['Ensemble_Equal']['mae'].append(mae)
        print(f"  {'Ensemble (50/50)':18s}: R²={r2:.3f}, RMSE={rmse:.2f}°C, MAE={mae:.2f}°C")
        
        # Ensemble: inverse RMSE weights (calculated per fold)
        rmse_xgb_fold = np.sqrt(mean_squared_error(y_test, y_pred_xgb))
        rmse_rf_fold = np.sqrt(mean_squared_error(y_test, y_pred_rf))
        
        inv_rmse_xgb = 1.0 / rmse_xgb_fold
        inv_rmse_rf = 1.0 / rmse_rf_fold
        total_inv = inv_rmse_xgb + inv_rmse_rf
        
        w_xgb = inv_rmse_xgb / total_inv
        w_rf = inv_rmse_rf / total_inv
        
        y_pred_weighted = w_xgb * y_pred_xgb + w_rf * y_pred_rf
        
        r2 = r2_score(y_test, y_pred_weighted)
        rmse = np.sqrt(mean_squared_error(y_test, y_pred_weighted))
        mae = mean_absolute_error(y_test, y_pred_weighted)
        results['Ensemble_Weighted']['r2'].append(r2)
        results['Ensemble_Weighted']['rmse'].append(rmse)
        results['Ensemble_Weighted']['mae'].append(mae)
        print(f"  {'Ensemble (weighted)':18s}: R²={r2:.3f}, RMSE={rmse:.2f}°C, MAE={mae:.2f}°C  [XGB:{w_xgb:.2f}, RF:{w_rf:.2f}]")
        
        fold += 1
    
    # Calculate global weights from mean RMSE across folds
    mean_rmse_xgb = np.mean(all_rmse_xgb)
    mean_rmse_rf = np.mean(all_rmse_rf)
    
    inv_rmse_xgb = 1.0 / mean_rmse_xgb
    inv_rmse_rf = 1.0 / mean_rmse_rf
    total_inv = inv_rmse_xgb + inv_rmse_rf
    
    global_weight_xgb = inv_rmse_xgb / total_inv
    global_weight_rf = inv_rmse_rf / total_inv
    
    # Summary
    print("\n" + "=" * 60)
    print("CROSS-VALIDATION SUMMARY")
    print("=" * 60)
    print(f"\n{'Model':<20} {'R²':>12} {'RMSE (°C)':>14} {'MAE (°C)':>14}")
    print("-" * 62)
    
    for name in model_names:
        r2_mean = np.mean(results[name]['r2'])
        r2_std = np.std(results[name]['r2'])
        rmse_mean = np.mean(results[name]['rmse'])
        rmse_std = np.std(results[name]['rmse'])
        mae_mean = np.mean(results[name]['mae'])
        mae_std = np.std(results[name]['mae'])
        
        print(f"{name:<20} {r2_mean:>5.3f}±{r2_std:<5.3f} {rmse_mean:>6.2f}±{rmse_std:<5.2f} {mae_mean:>6.2f}±{mae_std:<5.2f}")
        
        results[name]['r2_mean'] = r2_mean
        results[name]['r2_std'] = r2_std
        results[name]['rmse_mean'] = rmse_mean
        results[name]['rmse_std'] = rmse_std
        results[name]['mae_mean'] = mae_mean
        results[name]['mae_std'] = mae_std
    
    results['global_weights'] = {
        'XGBoost': global_weight_xgb,
        'RandomForest': global_weight_rf
    }
    
    print(f"\nOptimal weights (inverse RMSE): XGBoost={global_weight_xgb:.3f}, RandomForest={global_weight_rf:.3f}")
    
    best_model = max(model_names, key=lambda x: results[x]['r2_mean'])
    print(f"Best model by R²: {best_model} ({results[best_model]['r2_mean']:.3f})")
    
    return results


