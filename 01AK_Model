    source_ns = [s['n'] for s in source_stats]
    source_colors = ['steelblue' if s == 'Wang2018' else 'orange' for s in source_names]
    
    bars = ax.bar(source_names, source_r2s, color=source_colors, alpha=0.8)
    ax.set_ylabel('R² (Training Fit)')
    ax.set_title('Performance by Data Source')
    ax.set_ylim(0, 1)
    ax.grid(True, alpha=0.3, axis='y')
    
    for bar, r2_val, n in zip(bars, source_r2s, source_ns):
        ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.02,
                f'R²={r2_val:.3f}\nn={n}', ha='center', va='bottom', fontsize=10)
    
    plt.tight_layout()
    
    output_path = Path(output_dir) / 'ensemble_combined_diagnostic_plots.png'
    plt.savefig(output_path, dpi=150, bbox_inches='tight')
    print(f"Saved plots to: {output_path}")
    plt.close()


# =============================================================================
# 10. SAVE RESULTS
# =============================================================================

def save_ensemble_results(ensemble: WeightedEnsembleModel, cv_results: dict,
                          X: np.ndarray, y: np.ndarray, df: pd.DataFrame,
                          feature_names: list, output_dir: str):
    """Save ensemble model and results."""
    
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    
    # Save individual models
    ensemble.models['XGBoost'].save_model(output_dir / 'ensemble_xgboost.json')
    joblib.dump(ensemble.models['RandomForest'], output_dir / 'ensemble_randomforest.joblib')
    
    # Save weights
    weights_path = output_dir / 'ensemble_weights.json'
    with open(weights_path, 'w') as f:
        json.dump(ensemble.weights, f, indent=2)
    
    # Save feature names
    with open(output_dir / 'feature_names.json', 'w') as f:
        json.dump(feature_names, f, indent=2)
    
    print(f"Saved models and weights to {output_dir}")
    
    # Save predictions
    df_out = df.copy()
    individual_preds = ensemble.predict_individual(X)
    for name, preds in individual_preds.items():
        df_out[f'pred_{name}'] = preds
    df_out['pred_Ensemble'] = ensemble.predict(X)
    df_out['residual_Ensemble'] = df_out['pred_Ensemble'] - df_out['MAGT_100cm']
    
    predictions_path = output_dir / 'ensemble_combined_predictions.csv'
    df_out.to_csv(predictions_path, index=False)
    print(f"Saved predictions to: {predictions_path}")
    
    # Save CV summary
    wang_n = len(df[df['source'] == 'Wang2018'])
    gtnp_n = len(df[df['source'] == 'GTN-P'])
    wang_sites = df[df['source'] == 'Wang2018']['Code'].nunique()
    gtnp_sites = df[df['source'] == 'GTN-P']['Code'].nunique()
    
    summary_lines = [
        "Weighted Ensemble Model (XGBoost + RandomForest)",
        "COMBINED TRAINING: Wang2018 + GTN-P",
        "=" * 50,
        f"Date: {pd.Timestamp.now().strftime('%Y-%m-%d %H:%M')}",
        "",
        "DATA SUMMARY:",
        f"  Wang2018: {wang_n} samples, {wang_sites} sites",
        f"  GTN-P:    {gtnp_n} samples, {gtnp_sites} sites",
        f"  Total:    {len(y)} samples, {df['Code'].nunique()} sites",
        "",
        "Ensemble Weights (Inverse RMSE):",
        f"  XGBoost:      {ensemble.weights['XGBoost']:.4f}",
        f"  RandomForest: {ensemble.weights['RandomForest']:.4f}",
        "",
        "Site-Grouped CV Results:",
        "-" * 62,
        f"{'Model':<20} {'R²':>12} {'RMSE (°C)':>14} {'MAE (°C)':>14}",
        "-" * 62
    ]
    
    for name in ['XGBoost', 'RandomForest', 'Ensemble_Equal', 'Ensemble_Weighted']:
        r = cv_results[name]
        summary_lines.append(
            f"{name:<20} {r['r2_mean']:>5.3f}±{r['r2_std']:<5.3f} "
            f"{r['rmse_mean']:>6.2f}±{r['rmse_std']:<5.2f} "
            f"{r['mae_mean']:>6.2f}±{r['mae_std']:<5.2f}"
        )
    
    summary_lines.extend([
        "",
        "Model files:",
        "  - ensemble_xgboost.json",
        "  - ensemble_randomforest.joblib",
        "  - ensemble_weights.json",
        "  - feature_names.json"
    ])
    
    summary_path = output_dir / 'ensemble_combined_summary.txt'
    with open(summary_path, 'w') as f:
        f.write('\n'.join(summary_lines))
    print(f"Saved summary to: {summary_path}")


