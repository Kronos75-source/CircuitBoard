def load_wang2018(rs_path: str, gt_path: str) -> pd.DataFrame:
    """Load Wang2018 RS features and ground temperature data."""
    
    print("-" * 40)
    print("Loading Wang2018 dataset...")
    print("-" * 40)
    
    rs = pd.read_csv(rs_path)
    gt = pd.read_csv(gt_path)
    
    rs['Code'] = rs['Code'].astype(str).str.strip()
    gt['Code'] = gt['Code'].astype(str).str.strip()
    rs['Year'] = rs['Year'].astype(int)
    gt['Year'] = gt['Year'].astype(int)
    
    # Select columns for merge
    gt_cols = ['Code', 'Year', 'MAGT_100cm']
    # Add optional columns if they exist
    for col in ['MAGT_25cm', 'MAGT_50cm', 'MAGT_75cm', 'MAGST', 'MAAT', 'Lat', 'Lon']:
        if col in gt.columns:
            gt_cols.append(col)
    
    merged = pd.merge(rs, gt[gt_cols], on=['Code', 'Year'], how='inner')
    
    # Add source label
    merged['source'] = 'Wang2018'
    
    print(f"  RS features: {len(rs)} rows")
    print(f"  Ground temp: {len(gt)} rows")
    print(f"  Merged: {len(merged)} rows, {merged['Code'].nunique()} sites")
    
    return merged


# =============================================================================
# 2. LOAD AND MERGE GTN-P DATA
